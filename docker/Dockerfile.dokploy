FROM golang:1.26.2-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=3.6.4
ARG BUILD_DATE=2000-01-01T00:00:00Z
ARG GIT_COMMIT=unknown

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-s -w -X github.com/haierkeys/fast-note-sync-service/internal/app.Version=${VERSION} -X github.com/haierkeys/fast-note-sync-service/internal/app.GitTag=${GIT_COMMIT} -X github.com/haierkeys/fast-note-sync-service/internal/app.BuildTime=${BUILD_DATE}" \
    -o /out/fast-note-sync-service .

FROM alpine:3.22

ENV TZ=Asia/Shanghai
ENV P_NAME=fast-note-sync
ENV P_BIN=fast-note-sync-service

RUN apk --no-cache add ca-certificates curl bash tzdata \
    && cp /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo ${TZ} > /etc/timezone \
    && mkdir -p /fast-note-sync/config /fast-note-sync/storage

WORKDIR /fast-note-sync
COPY --from=builder /out/fast-note-sync-service /fast-note-sync/fast-note-sync-service
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /fast-note-sync/fast-note-sync-service

EXPOSE 9000
VOLUME ["/fast-note-sync/config", "/fast-note-sync/storage"]
ENTRYPOINT ["/entrypoint.sh"]
